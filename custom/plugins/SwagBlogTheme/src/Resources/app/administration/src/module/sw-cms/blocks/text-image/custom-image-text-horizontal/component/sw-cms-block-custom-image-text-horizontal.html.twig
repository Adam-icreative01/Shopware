{% block sw_cms_block_custom_image_text_horizontal %}
<div class="sw-cms-block-custom-image-text-horizontal">
    <div class="sw-cms-block-custom-image-text-horizontal__left">

        <div class="image-wrapper">
            <slot name="left-image">
                {% block sw_cms_block_my_custom_image_text_horizontal_left_image %} {% endblock %}
            </slot>        
            <div class="image-button">
                <slot name="left-button">
                    {% block sw_cms_block_my_custom_image_text_horizontal_left_button %}
                        
                    {% endblock %}
                </slot>
            </div>
        </div>
        <slot name="left-text">
            {% block sw_cms_block_my_custom_image_text_horizontal_left_text %}
                
            {% endblock %}
        </slot>
    </div>

    <div class="sw-cms-block-custom-image-text-horizontal__center">
        <div class="image-wrapper">
            <slot name="center-image">
                {% block sw_cms_block_my_custom_image_text_horizontal_center_image %}
                    
                {% endblock %}
            </slot>        
            <div class="image-button">
                <slot name="left-button">
                    {% block sw_cms_block_my_custom_image_text_horizontal_center_button %}
                        
                    {% endblock %}
                </slot>
            </div>
        </div>
        <slot name="center-text">
            {% block sw_cms_block_my_custom_image_text_horizontal_center_text %}
                
            {% endblock %}
        </slot>
    </div>

    <div class="sw-cms-block-custom-image-text-horizontal__center_2">
        <div class="image-wrapper">
            <slot name="center-image-2">
                {% block sw_cms_block_my_custom_image_text_horizontal_center_image_2 %}
                    
                {% endblock %}
            </slot>        
            <div class="image-button">   
                <slot name="left-button">
                    {% block sw_cms_block_my_custom_image_text_horizontal_center_button_2 %}
                        
                    {% endblock %}
                </slot>  
            </div>      
        </div>
        <slot name="center-text-2">
            {% block sw_cms_block_my_custom_image_text_horizontal_center_text_2 %}
                
            {% endblock %}
        </slot>
    </div>

    <div class="sw-cms-block-custom-image-text-horizontal__right">
        <div class="image-wrapper">
            <slot name="right-image">
                {% block sw_cms_block_my_custom_image_text_horizontal_right_image %}
                    
                {% endblock %}
            </slot>        
            <div class="image-button">
                <slot name="left-button">
                    {% block sw_cms_block_my_custom_image_text_horizontal_right_button %}
                        
                    {% endblock %}
                </slot>
            </div>
        </div>
        <slot name="right-text">
            {% block sw_cms_block_my_custom_image_text_horizontal_right_text %}
                
            {% endblock %}
        </slot>
    </div>
</div>
{% endblock %}
