{
  "name": "SwagBlogTheme",
  "author": "Kotwaladam",
  "views": [
     "@Storefront",
     "@Plugins",
     "@SwagBlogTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/swag-blog-theme/swag-blog-theme.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config" : {
    "fields" : {
      "sw-color-brand-primary" : {
        "label" : {
          "en-GB" : "Primary Color",
          "de-DE" : "Primärfarbe"
        },
        "type" : "color",
        "value" : "darkcyan"
      }
    }
  },
  "parentTheme" : "Storefront"
}