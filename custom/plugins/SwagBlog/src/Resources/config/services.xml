<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="SwagBlog\Core\Content\Blog\BlogDefinition">
            <tag name="shopware.entity.definition" entity="blog" />
        </service>

        <service id="SwagBlog\Core\Content\Blog\Aggregate\BlogTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_translation" />
        </service>


        <service id="SwagBlog\Core\Content\BlogCategory\BlogCategoryDefinition">
            <tag name="shopware.entity.definition" entity="blog_category" />
        </service>

        <service id="SwagBlog\Core\Content\BlogCategory\Aggregate\BlogCategoryTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_category_translation" />
        </service>


        <!-- Mapping Definition -->
        <service id="SwagBlog\Core\Content\BlogCategoryMappingDefinition">
            <tag name="shopware.entity.definition" entity="blog_category_mapping" />
        </service>

        <service id="SwagBlog\Core\Content\BlogProductMappingDefinition">
            <tag name="shopware.entity.definition" entity="blog_product_mapping" />
        </service>



        <!-- Extensions -->
        <service id="SwagBlog\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="SwagBlog\Core\Content\Extension\LanguageExtension">
            <tag name="shopware.entity.extension" />
        </service>


        <!-- Page Loader -->
        <service id="SwagBlog\Storefront\Page\BlogPageLoader" public="true">
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader" />
            <argument type="service" id="event_dispatcher"/>
        </service>


        <!-- Controllers -->
        <service id="SwagBlog\Storefront\Controller\BlogController" public="true">
            <!-- <argument type="service" id="SwagBlog\Storefront\Page\BlogPageLoader" /> -->
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <call method="setTwig">
                <argument type="service" id="twig"/>
            </call>
        </service>



        
    </services>
</container>